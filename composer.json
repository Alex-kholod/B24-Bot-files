{
    "name": "local/b24-docs-bot",
    "type": "project",
    "authors": [
        {
            "name": "Alex-kholod",
            "email": "al.kholodkov@gmail.com"
        }
    ],
    "require": {
        "php": "8.4.* || 8.5.*",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pdo_sqlite": "*",
        "bitrix24/b24phpsdk": "^3.3",
        "monolog/monolog": "^3",
        "symfony/event-dispatcher": "^7 || ^8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": { "psr-4": { "B24DocsBot\\": "src/" } },
    "autoload-dev": { "psr-4": { "B24DocsBot\\Tests\\": "tests/" } },
    "config": { "sort-packages": true },
    "scripts": { "test": "phpunit" }
}
